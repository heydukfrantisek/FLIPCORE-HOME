# Kopie na `secrets.yaml` a doplň vlastní hodnoty. `secrets.yaml` je v .gitignore.
# Referencuj jako `!secret wifi_ssid_iot` atd. Původní hodnoty z HA UI zjisti v
# Nástroje > systém > Obnovení / nebo v `.storage/core.config_entries`.

wifi_ssid_iot: "CHANGE-ME"
wifi_password_iot: "CHANGE-ME"

mqtt_username: "flipcore"
mqtt_password: "CHANGE-ME"

zigbee2mqtt_api_key: "CHANGE-ME"

influxdb_token: "CHANGE-ME"
